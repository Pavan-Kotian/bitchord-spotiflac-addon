PORT=8080
ADDON_NAME=SpotiFLAC Qobuz Lossless
ADDON_VERSION=0.4.0

# Qobuz provider settings from the upstream SpotiFLAC extension.
QOBUZ_APP_ID=798273057
QOBUZ_COUNTRY_CODE=US

# Keep the signed-session record outside the source tree and protect it like a password.
QOBUZ_SESSION_FILE=/data/qobuz-session.json
