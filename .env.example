PORT=8080
ADDON_NAME=SpotiFLAC Multi-Source Lossless
ADDON_VERSION=0.6.0

# Qobuz
QOBUZ_APP_ID=798273057
QOBUZ_COUNTRY_CODE=US
QOBUZ_SESSION_FILE=/data/qobuz-session.json

# External Tidal hifi-api service. Leave blank to disable.
ENABLE_TIDAL=true
TIDAL_API_URL=
# Optional bearer authentication if you put a proxy in front of hifi-api.
TIDAL_API_TOKEN=

# External Amazon Music API service. Leave blank to disable.
ENABLE_AMAZON=true
AMAZON_API_URL=
AMAZON_API_TOKEN=
