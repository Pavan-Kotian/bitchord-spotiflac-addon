PORT=8080
ADDON_NAME=SpotiFLAC Lossless Bridge
ADDON_VERSION=0.1.0
# Point this at a resolver that is authorized to access your chosen music provider.
# The resolver must implement GET /search?q=...&quality=lossless and GET /stream?id=...&quality=lossless.
SPOTIFLAC_RESOLVER_URL=https://your-authorized-resolver.example/api
SPOTIFLAC_RESOLVER_KEY=