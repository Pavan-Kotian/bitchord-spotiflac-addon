PORT=8080
SPOTIFLAC_RESOLVER_URL=http://localhost:8090
SPOTIFLAC_RESOLVER_KEY=
ADDON_NAME=SpotiFLAC Lossless Bridge
ADDON_VERSION=0.3.0

# Fabricated resolver settings
RESOLVER_PORT=8090
# For BitChord on another device, replace this with a URL reachable by that device.
# Example: http://192.168.1.50:8090 or your HTTPS public resolver URL.
PUBLIC_BASE_URL=http://YOUR-PC-LAN-IP:8090
